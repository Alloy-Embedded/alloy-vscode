{
  "name": "alloy-embedded",
  "displayName": "Alloy Embedded",
  "description": "Configure, build, flash and debug embedded C++ from the editor \u2014 one portable app source, any supported MCU.",
  "version": "0.3.0",
  "publisher": "alloy-embedded",
  "repository": {
    "type": "git",
    "url": "https://github.com/Alloy-Embedded/alloy-vscode.git"
  },
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other",
    "Debuggers"
  ],
  "activationEvents": [
    "workspaceContains:alloy.toml"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "alloy.setup",
        "title": "Alloy: Setup Environment"
      },
      {
        "command": "alloy.newProject",
        "title": "Alloy: New Project"
      },
      {
        "command": "alloy.pickBoard",
        "title": "Alloy: Pick Board"
      },
      {
        "command": "alloy.configureBoard",
        "title": "Alloy: Configure Board (clock, pins)"
      },
      {
        "command": "alloy.updateDevice",
        "title": "Alloy: Update Device (UART)"
      },
      {
        "command": "alloy.build",
        "title": "Alloy: Build"
      },
      {
        "command": "alloy.flash",
        "title": "Alloy: Flash"
      },
      {
        "command": "alloy.run",
        "title": "Alloy: Run (Flash + Monitor)"
      },
      {
        "command": "alloy.monitor",
        "title": "Alloy: Monitor"
      },
      {
        "command": "alloy.clean",
        "title": "Alloy: Clean"
      },
      {
        "command": "alloy.emulate",
        "title": "Alloy: Emulate (Renode)"
      },
      {
        "command": "alloy.buildAll",
        "title": "Alloy: Build All Boards"
      },
      {
        "command": "alloy.memory",
        "title": "Alloy: Memory & Partitions"
      },
      {
        "command": "alloy.debug",
        "title": "Alloy: Debug"
      },
      {
        "command": "alloy.generateLaunchJson",
        "title": "Alloy: Generate Debug Configuration (launch.json)"
      },
      {
        "command": "alloy.refreshTools",
        "title": "Alloy: Refresh Toolchains",
        "icon": "$(refresh)"
      },
      {
        "command": "alloy.installTools",
        "title": "Alloy: Install Missing Tools"
      },
      {
        "command": "alloy.addLibrary",
        "title": "Alloy: Add Library",
        "icon": "$(add)"
      },
      {
        "command": "alloy.refreshLibraries",
        "title": "Alloy: Refresh Libraries",
        "icon": "$(refresh)"
      },
      {
        "command": "alloy.refreshMemory",
        "title": "Alloy: Refresh Memory Usage",
        "icon": "$(refresh)"
      },
      {
        "command": "alloy.monitorPanel",
        "title": "Alloy: Monitor Panel (filter + plot)"
      },
      {
        "command": "alloy.ciInit",
        "title": "Alloy: Generate CI Workflow"
      },
      {
        "command": "alloy.upgradeCli",
        "title": "Alloy: Upgrade the CLI"
      }
    ],
    "taskDefinitions": [
      {
        "type": "alloy",
        "required": [
          "action"
        ],
        "properties": {
          "action": {
            "type": "string",
            "description": "build | flash | run | monitor | clean | gen | emulate | ci-init"
          },
          "board": {
            "type": "string",
            "description": "board id override (optional)"
          }
        }
      }
    ],
    "configuration": {
      "title": "Alloy",
      "properties": {
        "alloy.cliPath": {
          "type": "string",
          "default": "",
          "description": "Path to the alloy CLI. Empty = search uv tool shims and PATH."
        }
      }
    },
    "viewsContainers": {
      "activitybar": [
        {
          "id": "alloy",
          "title": "Alloy",
          "icon": "media/alloy.svg"
        }
      ]
    },
    "views": {
      "alloy": [
        {
          "id": "alloyActions",
          "name": "Project",
          "icon": "media/alloy.svg"
        },
        {
          "id": "alloyMemory",
          "name": "Memory",
          "icon": "media/alloy.svg"
        },
        {
          "id": "alloyLibraries",
          "name": "Libraries",
          "icon": "media/alloy.svg"
        },
        {
          "id": "alloyTools",
          "name": "Toolchains",
          "icon": "media/alloy.svg"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "alloyActions",
        "contents": "Welcome to Alloy \u2014 one portable C++23 app, any supported MCU.\n\n[New Project](command:alloy.newProject)\n\n[Set Up Environment](command:alloy.setup)\n\nOpen a folder with alloy.toml to see build / flash / monitor.",
        "when": "workbenchState == empty"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "alloy.refreshTools",
          "when": "view == alloyTools",
          "group": "navigation"
        },
        {
          "command": "alloy.newProject",
          "when": "view == alloyActions",
          "group": "navigation"
        },
        {
          "command": "alloy.addLibrary",
          "when": "view == alloyLibraries",
          "group": "navigation"
        },
        {
          "command": "alloy.refreshLibraries",
          "when": "view == alloyLibraries",
          "group": "navigation"
        },
        {
          "command": "alloy.refreshMemory",
          "when": "view == alloyMemory",
          "group": "navigation"
        }
      ]
    },
    "walkthroughs": [
      {
        "id": "alloy.getStarted",
        "title": "Get started with Alloy",
        "description": "From nothing installed to the same firmware running on nine boards \u2014 no hardware required for any of it.",
        "featuredFor": [
          "alloy.toml"
        ],
        "steps": [
          {
            "id": "cli",
            "title": "Install the alloy CLI",
            "description": "This extension holds no knowledge of silicon: every board, pin and clock it shows comes from the `alloy` CLI over versioned JSON. Install it once and the Toolchains view turns green.\n[Setup Environment](command:alloy.setup)",
            "media": {
              "svg": "media/walkthrough/cli.svg",
              "altText": "The extension asks the CLI, which reads a curated silicon database"
            },
            "completionEvents": [
              "onCommand:alloy.setup",
              "onCommand:alloy.installTools"
            ]
          },
          {
            "id": "project",
            "title": "Start from a real board",
            "description": "Pick one of the curated boards and get a project whose pins, clock and linker script are already right. The board is one line of `alloy.toml` \u2014 change it and the same `main.cpp` targets another MCU.\n[New Project](command:alloy.newProject)",
            "media": {
              "svg": "media/walkthrough/board.svg",
              "altText": "A board list, and the one line of alloy.toml that selects one"
            },
            "completionEvents": [
              "onCommand:alloy.newProject",
              "onCommand:alloy.pickBoard"
            ]
          },
          {
            "id": "configure",
            "title": "Open the chip, not a form",
            "description": "The package with its real pinout, every board role the silicon can fill, and the whole clock tree. A pin with no route to its peripheral is a build error you meet here instead \u2014 with the pins that would work as one-click fixes.\n[Configure Board](command:alloy.configureBoard)",
            "media": {
              "svg": "media/walkthrough/configure.svg",
              "altText": "A chip package beside its role panel, with a problem reported on the field that caused it"
            },
            "completionEvents": [
              "onCommand:alloy.configureBoard"
            ]
          },
          {
            "id": "emulate",
            "title": "Run it with no hardware",
            "description": "Renode runs the same `.elf` the flasher would write, and the device's UART comes back as text. Useful before the hardware arrives \u2014 and in CI forever after.\n[Emulate (Renode)](command:alloy.emulate)",
            "media": {
              "svg": "media/walkthrough/emulate.svg",
              "altText": "An .elf running under Renode with no board attached, printing over UART"
            },
            "completionEvents": [
              "onCommand:alloy.emulate",
              "onCommand:alloy.build"
            ]
          },
          {
            "id": "matrix",
            "title": "Check the claim",
            "description": "One `src/`, every board you target, two instruction sets, with flash and RAM side by side. Portability is easy to assert and this is it measured \u2014 a board that fails is a row with a reason.\n[Build All Boards](command:alloy.buildAll)",
            "media": {
              "svg": "media/walkthrough/matrix.svg",
              "altText": "One source tree building for five boards, each with its size"
            },
            "completionEvents": [
              "onCommand:alloy.buildAll"
            ]
          }
        ]
      }
    ]
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "bundle": "node esbuild.mjs",
    "build": "npm run typecheck && npm run bundle",
    "package": "vsce package --no-dependencies",
    "test:render": "node test/render.test.mjs",
    "test": "npm run build && npm run test:unit && node test/runTest.js",
    "test:unit": "node test/version-gate.test.mjs && node test/manifest.test.mjs && npm run test:render"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "@types/vscode": "^1.90.0",
    "@vscode/test-electron": "^3.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "mocha": "^11.7.6",
    "typescript": "^5.5.0"
  },
  "keywords": [
    "embedded",
    "microcontroller",
    "arm",
    "cortex-m",
    "stm32",
    "esp32",
    "rp2040",
    "risc-v",
    "c++",
    "firmware"
  ],
  "icon": "media/icon.png",
  "homepage": "https://github.com/Alloy-Embedded/alloy",
  "bugs": {
    "url": "https://github.com/Alloy-Embedded/alloy-vscode/issues"
  },
  "galleryBanner": {
    "color": "#12171D",
    "theme": "dark"
  },
  "preview": true,
  "qna": false
}
